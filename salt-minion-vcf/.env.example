IMAGE_REPOSITORY=salt-minion-vcf
IMAGE_TAG=0.1.0
SALT_VERSION=3008.2
# Optional extra Salt extension packages, space-separated.
# Primary/reproducible extension set is defined in salt-extensions.txt.
EXTRA_SALT_EXTENSIONS=

# Optional corporate/internal PyPI mirror configuration for building behind
# a proxy (e.g. an internal Artifactory instance). Leave empty for public PyPI.
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_ONLY_BINARY=

# Optional internal mirrors for air-gapped/restricted-network builds.
# Leave empty to use the public defaults (Ubuntu's own mirrors, Broadcom's
# public Artifactory).
APT_MIRROR=
SALT_GPG_KEY_URL=
SALT_APT_REPO_URL=

SALT_MASTER=salt-master.example.com
SALT_MASTER_PORT=4506
SALT_PUBLISH_PORT=4505
SALT_MINION_ID=vcf-docker-executor-01
SALT_MASTER_FINGER=
SALT_LOG_LEVEL=info

# Opt-in, unverified beyond basic testing - see README.md "Vault Integration"
# before relying on this for real Master-dispatched jobs.
SALT_FILE_CLIENT_LOCAL=false

# Vault integration (saltext.vault). All optional - disabled unless VAULT_ADDR
# is set. Prefer VAULT_SECRET_ID_FILE (a mounted file) over VAULT_SECRET_ID
# (plain env var, visible in `docker inspect`) for the actual secret.
VAULT_ADDR=
VAULT_AUTH_METHOD=approle
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_SECRET_ID_FILE=
VAULT_TOKEN=
VAULT_TOKEN_FILE=
